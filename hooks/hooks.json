{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
